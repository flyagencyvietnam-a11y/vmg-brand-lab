# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit khóa thật (spec 8.3).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ máy chủ và script seed. Bỏ qua RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Chế độ thử cục bộ: đọc hành trình từ seed/journey.json, không cần Supabase, không đăng nhập.
# Chỉ hoạt động khi NODE_ENV khác production (bị bỏ qua ở bản build production). Xem README.
# BRAND_LAB_DEV_SEED=1

# Google Drive (kho tệp gốc, Giai đoạn 0-1; lib/drive đã có, chưa nối vào giao diện)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
DRIVE_SHARED_DRIVE_ID=
DRIVE_OFFICIAL_ROOT_ID=
DRIVE_DRAFT_ROOT_ID=
# Q18: false nếu tài khoản dịch vụ chỉ có quyền đọc (không ghim bản sửa, chỉ dựa vào phát hiện lệch)
DRIVE_SERVICE_ACCOUNT_CAN_PIN=true
DOWNLOAD_PROXY_MAX_MB=50
RENDER_CACHE_MAX_MB=500
GENERATION_RETENTION_DAYS=90

# Ứng dụng
APP_BASE_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=

# AI (Giai đoạn 2; chưa dùng ở bản khung này)
AI_TEXT_PROVIDER=
ANTHROPIC_API_KEY=
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=

# Thư điện tử giao dịch, giám sát, tác vụ nền
EMAIL_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
CRON_SECRET=
